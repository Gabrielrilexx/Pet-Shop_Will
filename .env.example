# ============================================================
# MODELO de configuração do sistema (este arquivo VAI para o GitHub)
# ------------------------------------------------------------
# Como usar:
#   1. Copie este arquivo e renomeie a cópia para .env
#   2. Preencha os valores reais no .env
#   3. NUNCA faça commit do .env (o .gitignore já bloqueia)
# ============================================================

# --- Banco de dados MySQL ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Coordenadas da loja (ponto de partida das entregas) ---
# Formato decimal, com ponto. Exemplo: LOJA_LAT=-22.5645
LOJA_LAT=-22.5706902
LOJA_LON=-47.4073115